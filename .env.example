# ═══════════════════════════════════════════════════════
#  Advantage First Financial — Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it's in .gitignore.

# PostHog Analytics — *** Do NOT Alter ***
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase (if using)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# GHL — Inbound Webhook (if using)
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-hook

# GHL — Contacts API (if using)
GHL_API_KEY=your-api-key
GHL_LOCATION_ID=your-location-id

# Salesforce (if using)
SALESFORCE_OID=your-org-id
